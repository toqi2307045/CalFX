<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.CalFX.controller.GraphController">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="16">
            <Button text="← Home" styleClass="header-button" onAction="#onHome"/>
            <Label text="Function graph" styleClass="header-title"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="20" right="28" bottom="20" left="28"/>
            </padding>

            <VBox styleClass="function-bar" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Plot type" styleClass="function-label"/>
                    <ComboBox fx:id="plotTypeBox" styleClass="plot-type-box" prefWidth="190" onAction="#onPlotTypeChanged"/>
                    <Label fx:id="expressionLabel" text="f(x) =" styleClass="function-label"/>
                    <TextField fx:id="functionField" styleClass="function-field" promptText="e.g. sin(x) + x^2 / 5"
                               onAction="#onPlot" HBox.hgrow="ALWAYS"/>
                    <Button text="Plot" styleClass="primary-button" onAction="#onPlot"/>
                    <Button text="Clear" styleClass="secondary-button" onAction="#onClear"/>
                </HBox>
                <HBox fx:id="secondaryInputRow" alignment="CENTER_LEFT" spacing="12" visible="false" managed="false">
                    <Label fx:id="secondaryExpressionLabel" text="y(t) =" styleClass="function-label"/>
                    <TextField fx:id="secondaryFunctionField" styleClass="function-field" promptText="e.g. cos(t)"
                               onAction="#onPlot" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="rangeLabel" text="t range" styleClass="hint-label"/>
                    <TextField fx:id="rangeMinField" styleClass="function-field" text="-10" promptText="Min" prefWidth="80"/>
                    <TextField fx:id="rangeMaxField" styleClass="function-field" text="10" promptText="Max" prefWidth="80"/>
                </HBox>
                <Label fx:id="messageLabel" styleClass="hint-label" wrapText="true"/>
            </VBox>

            <!-- 2. the window beneath it where the graph is drawn -->
            <StackPane styleClass="graph-frame" VBox.vgrow="ALWAYS">
                <StackPane fx:id="graphContainer"/>
            </StackPane>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="coordinatesLabel" styleClass="coords-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="X-" accessibleText="Zoom X axis out" styleClass="secondary-button" onAction="#onZoomXOut"/>
                <Button text="X+" accessibleText="Zoom X axis in" styleClass="secondary-button" onAction="#onZoomXIn"/>
                <Button text="Y-" accessibleText="Zoom Y axis out" styleClass="secondary-button" onAction="#onZoomYOut"/>
                <Button text="Y+" accessibleText="Zoom Y axis in" styleClass="secondary-button" onAction="#onZoomYIn"/>
                <Button text="−" styleClass="secondary-button, round-button" onAction="#onZoomOut"/>
                <Button text="+" styleClass="secondary-button, round-button" onAction="#onZoomIn"/>
                <Button text="Reset view" styleClass="secondary-button" onAction="#onResetView"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
