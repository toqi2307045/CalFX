<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.CalFX.controller.PersonalizationController">
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="16">
            <Button text="← Home" styleClass="header-button" onAction="#onHome"/>
            <Label text="Personalization" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="18" styleClass="personalization-content">
            <Label text="Choose a color theme" styleClass="section-title"/>
            <ComboBox fx:id="presetChoice" prefWidth="360" styleClass="theme-choice"/>
            <HBox spacing="24" VBox.vgrow="ALWAYS">
                <VBox spacing="12" styleClass="color-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Region fx:id="primaryPreview" styleClass="color-preview"/>
                        <VBox spacing="3">
                            <Label text="Primary color" styleClass="section-title"/>
                            <Label fx:id="primaryHex" styleClass="hint-label"/>
                        </VBox>
                    </HBox>
                    <GridPane hgap="12" vgap="16" styleClass="rgb-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="22"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="42"/>
                        </columnConstraints>
                        <Label text="R" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Slider fx:id="primaryRed" min="0" max="255" majorTickUnit="51" showTickMarks="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label fx:id="primaryRedValue" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label text="G" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Slider fx:id="primaryGreen" min="0" max="255" majorTickUnit="51" showTickMarks="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label fx:id="primaryGreenValue" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <Label text="B" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Slider fx:id="primaryBlue" min="0" max="255" majorTickUnit="51" showTickMarks="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label fx:id="primaryBlueValue" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    </GridPane>
                </VBox>
                <VBox spacing="12" styleClass="color-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Region fx:id="backgroundPreview" styleClass="color-preview"/>
                        <VBox spacing="3">
                            <Label text="Background color" styleClass="section-title"/>
                            <Label fx:id="backgroundHex" styleClass="hint-label"/>
                        </VBox>
                    </HBox>
                    <GridPane hgap="12" vgap="16" styleClass="rgb-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="22"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="42"/>
                        </columnConstraints>
                        <Label text="R" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Slider fx:id="backgroundRed" min="0" max="255" majorTickUnit="51" showTickMarks="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label fx:id="backgroundRedValue" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label text="G" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Slider fx:id="backgroundGreen" min="0" max="255" majorTickUnit="51" showTickMarks="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label fx:id="backgroundGreenValue" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <Label text="B" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Slider fx:id="backgroundBlue" min="0" max="255" majorTickUnit="51" showTickMarks="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label fx:id="backgroundBlueValue" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    </GridPane>
                </VBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button text="Apply custom colors" styleClass="primary-button" onAction="#onApplyCustom"/>
                <Label fx:id="statusLabel" styleClass="hint-label" wrapText="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
